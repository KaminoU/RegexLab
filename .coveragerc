# Coverage configuration: the coverage gate (tox and the CI) and plain pytest runs

[run]
# The repository root: RegexLab.py, src/ and tools/ (coverage searches only directories that hold __init__.py)
source = .
branch = True
omit =
    */site-packages/*
    */tests/*
    */__pycache__/*

[report]
precision = 2
show_missing = True
skip_covered = False

# An explicit list, so that coverage 7.6.1 (Python 3.8) and 7.16.2 (Python 3.14) exclude the same lines: their default
# lists differ. The first six patterns are those the test configuration used so far; "if TYPE_CHECKING:" is added.
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code
    def __repr__

    # Don't complain if tests don't hit defensive assertion code
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run
    if __name__ == .__main__.:

    # Don't complain about abstract methods
    @abstractmethod

    # Imports for type checkers only: never run, by construction
    if TYPE_CHECKING:

# Explicit too: coverage's default pattern also honours other spellings of the branch pragma, which the coverage gate
# does not count. Only the spelling it counts excuses a partial branch.
partial_branches =
    pragma: no branch

[html]
directory = htmlcov
